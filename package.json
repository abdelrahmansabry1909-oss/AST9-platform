{
  "name": "ast9-health-hub",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test:smoke": "playwright test",
    "test:smoke:public": "playwright test --project=public",
    "test:smoke:staging": "playwright test --project=authenticated",
    "test:unit:staging-fixtures": "node --test tests/unit/fixture-contract.test.js",
    "test:unit:staging-safety": "node --test tests/unit/staging-target.test.js tests/unit/fixture-contract.test.js tests/unit/provision-guard.test.js tests/unit/subscription-writes.test.js tests/unit/system-rpc-boundaries.test.js",
    "staging:provision-check": "node scripts/staging-provision.mjs --check",
    "staging:validate": "node tests/staging/cli.mjs validate",
    "staging:seed": "node tests/staging/cli.mjs seed",
    "staging:verify": "node tests/staging/cli.mjs verify",
    "staging:reset": "node tests/staging/cli.mjs reset",
    "staging:authz-subscriptions": "node tests/staging/cli.mjs authz-subscriptions",
    "staging:authz-system-rpcs": "node tests/staging/cli.mjs authz-system-rpcs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.39.0",
    "chart.js": "^4.4.0",
    "three": "^0.158.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "supabase": "2.109.1",
    "vite": "^5.0.0"
  }
}
